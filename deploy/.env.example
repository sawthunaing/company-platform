# Server settings for compose.prod.yaml. Copy to /opt/company-platform/.env on the
# server, fill in every value, then: chmod 600 .env. Never commit the real file.

# The site is served at www.<DOMAIN>, admin.<DOMAIN> and api.<DOMAIN>. <DOMAIN> redirects to www.
DOMAIN=
# Let's Encrypt account email: expiry and problem notices.
ACME_EMAIL=
# Where deploy.sh pulls images from.
REGISTRY=ghcr.io/sawthunaing/company-platform

POSTGRES_USER=app
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=company

# 32+ characters: openssl rand -hex 32. Changing it logs every staff user out.
JWT_SECRET=
JWT_EXPIRES_IN=1h
LOG_LEVEL=info

# Time zone for the 02:00 daily backup.
TZ=UTC
BACKUP_KEEP_DAYS=7

# Off-site copy of the backups (optional, recommended). Any S3-compatible storage,
# e.g. Backblaze B2. Leave RCLONE_REMOTE empty to keep backups on this server only.
# RCLONE_REMOTE=offsite:<bucket>/company-platform
RCLONE_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# B2 example: https://s3.<region>.backblazeb2.com
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
