# Copy to .env to override the local dev defaults in compose.yaml.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=company

# 32+ characters. Use a long random value outside local dev.
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=1h

# The backoffice and the website, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

LOG_LEVEL=info
